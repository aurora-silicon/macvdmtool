<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.asahilinux.macvdmd</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PREFIX@/libexec/macvdmd</string>
        <string>--user</string>
        <string>@USER@</string>
        <string>--tool</string>
        <string>@PREFIX@/libexec/macvdmtool</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/log/macvdmd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/macvdmd.err</string>
</dict>
</plist>
